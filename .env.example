# AI Chat Room Configuration
# ===========================

# Default: Local Gemma 3 4B model via Ollama (Pixel TPU optimized)
# No API key needed for local mode - just run Ollama with Gemma 3
# CHAT_MODEL=ollama/gemma3:4b

# Ollama API Base (for local models)
# OLLAMA_API_BASE=http://localhost:11434

# Google API Key (for cloud mode with Gemini)
# Get from: https://makersuite.google.com/app/apikey
# GOOGLE_API_KEY=your-google-api-key-here

# Alternative: Gemini API Key
# GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI API Key (optional, for GPT models)
# OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Key (optional, for Claude models)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Azure OpenAI (optional)
# AZURE_API_KEY=your-azure-api-key-here
# AZURE_API_BASE=https://your-resource.openai.azure.com
